<Layouts.app flash={@flash}>
  <section class="space-y-4">
    <h1 class="text-3xl font-semibold tracking-tight">
      Plaže za pse na hrvatskom Jadranu
    </h1>
    <p class="max-w-2xl text-base-content/80">
      Dogo pokazuje najbliže plaže na kojima smiješ biti sa psom — s pravom udaljenošću,
      upozorenjem kad je plaža preko mora i popisom sadržaja.
    </p>
  </section>

  <section class="rounded-xl border border-base-300 p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60">
      U bazi
    </h2>
    <p class="mt-1 text-2xl font-semibold">
      {@beach_count} <span class="text-base font-normal text-base-content/70">plaža</span>
    </p>
    <p class="mt-3 text-sm text-base-content/70">
      Karta i pretraga stižu u sljedećoj fazi. Oznake izvora podatka:
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <.dog_status status={:designated} />
      <.dog_status status={:allowed} />
      <.dog_status status={:not_allowed} />
      <.dog_status status={:unknown} />
      <.dog_status_source source={:osm} />
      <.dog_status_source source={:generated} />
    </div>
  </section>
</Layouts.app>
